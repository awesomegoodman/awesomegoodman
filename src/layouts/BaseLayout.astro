---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config';
import { pathTo } from '../lib/content';
import '../styles/global.css';
import { canonicalOrigin, indexable } from '../../site.config.mjs';
interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  date?: Date;
  updated?: Date;
  noindex?: boolean;
  canonicalPath?: string;
  author?: string | false;
}
const {
  title,
  description = site.description,
  type = 'website',
  date,
  updated,
  noindex = false,
  author = site.author,
} = Astro.props;
const fullTitle = title
  ? `${title} · ${site.title}`
  : `${site.title} — ${site.author}'s notebook`;
const pageUrl = new URL(
  Astro.props.canonicalPath ?? Astro.url.pathname,
  Astro.site,
);
const image = new URL(pathTo('og.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          /* Use the system colour preference when storage is unavailable. */
        }
        document.documentElement.dataset.theme =
          theme === 'light' || theme === 'dark'
            ? theme
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {author && <meta name="author" content={author} />}
    <meta
      name="theme-color"
      content="#f7f6f2"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1b1e1c"
      media="(prefers-color-scheme: dark)"
    />
    {(noindex || !indexable) && (
      <meta name="robots" content="noindex, follow" />
    )}
    {canonicalOrigin && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href={pathTo('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={pathTo('sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} RSS`}
      href={pathTo('rss.xml')}
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.title} by ${site.author}: software engineering, robotics, machine learning, and ideas`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    {updated && (
      <meta property="article:modified_time" content={updated.toISOString()} />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
