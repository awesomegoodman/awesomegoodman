<figure class="notebook-diagram">
  <svg
    viewBox="0 0 400 330"
    role="img"
    aria-labelledby="notebook-title notebook-desc"
  >
    <title id="notebook-title">Ideas meet at the edges</title>
    <desc id="notebook-desc">
      Three overlapping circles connect software, intelligent machines, and
      ideas, with a dot at their intersection.
    </desc>
    <defs>
      <pattern id="dots" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r=".7" fill="currentColor" opacity=".2" />
      </pattern>
    </defs>
    <rect width="400" height="330" fill="url(#dots)" />
    <g fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="161" cy="132" r="83" />
      <circle cx="239" cy="132" r="83" />
      <circle cx="200" cy="197" r="83" />
      <path d="M200 25v275M45 164h310" stroke-dasharray="2 6" opacity=".25" />
    </g>
    <path
      d="M163 156q37-40 74 0-8 39-37 49-30-10-37-49Z"
      fill="var(--accent)"
      opacity=".12"
    />
    <circle cx="200" cy="157" r="5" fill="var(--accent)" />
    <circle
      cx="200"
      cy="157"
      r="10"
      fill="none"
      stroke="var(--accent)"
      opacity=".45"
    />
    <g fill="currentColor" font-size="10" font-family="monospace">
      <text x="92" y="117">
        SOFTWARE
      </text>
      <text x="250" y="117">
        MACHINES
      </text>
      <text x="185" y="244">
        IDEAS
      </text>
      <text x="16" y="315" opacity=".6">
        FIG. 01
      </text>
      <text x="263" y="315" opacity=".6">
        THE OVERLAP
      </text>
    </g>
    <path d="m205 154 45-32" stroke="var(--accent)" stroke-width="1" />
    <text
      x="258"
      y="149"
      fill="var(--accent)"
      font-size="11"
      font-style="italic"
      font-family="Georgia,serif"
    >
      a place to explore
    </text>
  </svg>
  <figcaption>Interesting things happen at the intersections.</figcaption>
</figure>
