---
interface Props {
  name: string;
  role: string;
  timeframe: string;
}
const { name, role, timeframe } = Astro.props;
---

<div class="timeline__block pb-4 last:pb-0 pl-timeline relative">
  <div class="timeline__bullet h-[8px] w-[8px] rounded-full bg-accent absolute top-4 left-0"></div>
  <div class="timeline__header">
    <h3 class="timeline__title mb-1 font-sans font-medium text-white [font-variant-ligatures:common-ligatures] text-lg leading-8">
      {name}
    </h3>
    <p class="timeline__meta text-job mb-1 font-sans font-light leading-7">
      {role}
    </p>
    <p class="timeline__timeframe text-xs mt-[-2px] mb-8 leading-6 uppercase tracking-wider text-muted">
      {timeframe}
    </p>
  </div>
  <div class="timeline__desc">
    <slot />
  </div>
</div>
