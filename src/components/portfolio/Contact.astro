---
import SectionTitle from './SectionTitle.astro';
import DisplayText from './DisplayText.astro';
import ButtonLink from './ButtonLink.astro';
---

<section id="contact" class="s-contact target-section">
  <div class="contact-top pt-40 w-shell max-w-content flex flex-wrap mx-auto border-t border-t-rule max-md:pt-32 max-sm:w-full max-sm:px-edge">
    <div class="flex-none w-full px-gutter max-2xs:px-0">
      <SectionTitle>Get In Touch</SectionTitle>

      <DisplayText>
        I love to hear from you. Whether you have a question or just want to
        chat about engineering, tech, or anime 😉
      </DisplayText>
    </div>
  </div>

  <div class="contact-bottom mt-24 pb-24 w-shell max-w-content flex flex-wrap mx-auto border-b border-b-rule max-sm:w-full max-sm:px-edge">
    <div class="flex-none w-1/4 px-gutter max-2xs:px-0 max-xl:w-[41.66667%] max-md:w-1/2 max-phone:w-full">
      <SectionTitle as="h3" spacing="tight">
        Reach me at
        <p class="contact-links text-lead mb-8 font-light leading-10 text-muted">
          <a
            href="mailto:goodman.awesome@gmail.com"
            class="mailtoui text-muted transition-all focus:text-accent hover:text-accent hover:outline-none active:outline-none"
          >
            goodman.awesome@gmail.com
          </a>{' '}
          <br />
          <a
            class="text-muted transition-all focus:text-accent hover:text-accent hover:outline-none active:outline-none"
            href="tel:+2349132162576"
          >
            +234 913 216 2576
          </a>
        </p>
      </SectionTitle>
    </div>
    <div class="flex-none w-[33.33333%] px-gutter max-2xs:px-0 max-xl:w-[41.66667%] max-md:w-1/2 max-phone:w-full">
      <SectionTitle as="h3" spacing="tight">
        Social
        <ul class="contact-social mb-8 list-none text-lead font-light leading-10 text-muted">
          <li class="inline-block after:content-[',__']">
            <a
              class="text-muted transition-all focus:text-accent hover:text-accent hover:outline-none active:outline-none"
              href="https://github.com/awesomegoodman"
            >
              Github
            </a>
          </li>
          <li class="inline-block after:content-[',__'] after:hidden">
            <a
              class="text-muted transition-all focus:text-accent hover:text-accent hover:outline-none active:outline-none"
              href="https://api.whatsapp.com/send?phone=2349132162576"
            >
              Whatsapp
            </a>
          </li>
        </ul>
      </SectionTitle>
    </div>
    <div class="flex-none w-[33.33333%] px-gutter max-2xs:px-0 max-xl:w-full">
      <ButtonLink
        href="mailto:goodman.awesome@gmail.com"
        class="mailtoui contact-btn mb-4 ml-auto max-xl:mt-4 max-xl:ml-0"
      >
        Say Hello.
      </ButtonLink>
    </div>
  </div>
</section>
