---
import SectionTitle from './SectionTitle.astro';
import DisplayText from './DisplayText.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';
import Testimonial from './Testimonial.astro';
import retailboxPreviewSource from '../../assets/portfolio/portfolio/retailbox.jpg';
import snakePreviewSource from '../../assets/portfolio/portfolio/snake.png';
import chessPreviewSource from '../../assets/portfolio/portfolio/chess.jpg';
import vendboxPreviewSource from '../../assets/portfolio/portfolio/vendbox.jpg';
import retailboxGallerySource from '../../assets/portfolio/portfolio/gallery/g-retailbox.jpg';
import snakeGallerySource from '../../assets/portfolio/portfolio/gallery/g-snake.jpg';
import chessGallerySource from '../../assets/portfolio/portfolio/gallery/g-chess.jpg';
import vendboxGallerySource from '../../assets/portfolio/portfolio/gallery/g-vendbox.jpg';
import jojuAvatarSource from '../../assets/portfolio/avatars/user-03.jpg';
import emmanuelAvatarSource from '../../assets/portfolio/avatars/user-01.jpg';
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'p';
const Subheading = standalone ? 'p' : 'h2';
import { getImage } from 'astro:assets';
const [
  retailboxPreview,
  snakePreview,
  chessPreview,
  vendboxPreview,
  retailboxGallery,
  snakeGallery,
  chessGallery,
  vendboxGallery,
  jojuAvatar,
  emmanuelAvatar,
] = await Promise.all([
  getImage({
    src: retailboxPreviewSource,
    width: Math.min(360, retailboxPreviewSource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: snakePreviewSource,
    width: Math.min(360, snakePreviewSource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: chessPreviewSource,
    width: Math.min(360, chessPreviewSource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: vendboxPreviewSource,
    width: Math.min(360, vendboxPreviewSource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: retailboxGallerySource,
    width: Math.min(1360, retailboxGallerySource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: snakeGallerySource,
    width: Math.min(1360, snakeGallerySource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: chessGallerySource,
    width: Math.min(1360, chessGallerySource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: vendboxGallerySource,
    width: Math.min(1360, vendboxGallerySource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: jojuAvatarSource,
    width: Math.min(144, jojuAvatarSource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: emmanuelAvatarSource,
    width: Math.min(144, emmanuelAvatarSource.width),
    format: 'webp',
    quality: 90,
  }),
]);
---

<section
  id="works"
  class="s-works target-section pt-40 pb-28 max-md:pt-32 max-md:pb-24"
>
  <div class="works-portfolio w-shell max-w-content flex flex-wrap mx-auto max-sm:w-full max-sm:px-edge">
    <div class="flex-none w-full px-gutter max-2xs:px-0" data-animate-block="">
      <SectionTitle as={Subheading} animated>
        Recent Works
      </SectionTitle>
      <DisplayText as={Heading} animated>
        Here are some of my favorite projects I have done lately. Feel free to
        check them out.
      </DisplayText>

      <ul class="folio-list mt-32 mb-8 list-none w-auto max-w-none flex flex-row flex-wrap [--project-size:--spacing(36)] -mx-gutter max-2xs:mx-0 max-xs:[--project-size:--spacing(28)]">
        <ProjectCard
          id="modal-01"
          image={retailboxPreview}
          category="Fullstack Web Application"
          label="Read about Retailbox"
          href="https://www.retailbox.co"
          visitLabel="Visit Retailbox project"
        >
          retailbox.
        </ProjectCard>

        <ProjectCard
          id="modal-02"
          image={snakePreview}
          category="Game & AI"
          label="Read about Snake Game with Reinforcement Learning"
          href="https://github.com/awesomegoodman/RL_Snake"
          visitLabel="Visit Snake Game with Reinforcement Learning project"
        >
          Classic Snake Game + Reinforcement Learning.
        </ProjectCard>

        <ProjectCard
          id="modal-03"
          image={chessPreview}
          category="Game & AI"
          label="Read about Chess Engine"
          href="https://github.com/awesomegoodman/chess-engine"
          visitLabel="Visit Chess Engine project"
        >
          Chess Engine.
        </ProjectCard>

        <ProjectCard
          id="modal-04"
          image={vendboxPreview}
          category="IoT"
          label="Read about Vendbox"
          href="https://vend.retailbox.co"
          visitLabel="Visit Vendbox project"
        >
          Vendbox.
        </ProjectCard>
      </ul>
    </div>

    <ProjectDialog
      id="modal-01"
      image={retailboxGallery}
      alt="Retailbox dashboard"
      title="Retailbox"
      href="https://www.retailbox.co"
      tags={['Fullstack Web Application', 'SaaS']}
    >
      A comprehensive retail management platform built for businesses of all
      sizes. Designed and developed as a full-stack solo project, featuring
      inventory management, sales tracking, analytics, and multi-store support.
    </ProjectDialog>

    <ProjectDialog
      id="modal-02"
      image={snakeGallery}
      alt="Snake reinforcement learning project"
      title="Snake Game with Reinforcement Learning"
      href="https://github.com/awesomegoodman/RL_Snake"
      tags={['Game Development', 'Artificial Intelligence']}
    >
      A Python implementation of the classic Snake game featuring both human
      play and an autonomous Q-Learning agent. It demonstrates practical
      reinforcement learning through Bellman-based Q-updates, state-action value
      optimisation, and interactive agent training.
    </ProjectDialog>

    <ProjectDialog
      id="modal-03"
      image={chessGallery}
      alt="Chess engine project"
      title="Chess Engine"
      href="https://github.com/awesomegoodman/chess-engine"
      tags={['Game Development', 'Artificial Intelligence']}
    >
      A custom C++ chess engine implementing core game logic, move generation,
      and evaluation strategies. Built to explore game theory concepts, search
      algorithms, and decision-making in competitive environments.
    </ProjectDialog>

    <ProjectDialog
      id="modal-04"
      image={vendboxGallery}
      alt="Vendbox IoT system"
      title="Vendbox"
      href="https://vend.retailbox.co"
      tags={['IoT', 'Embedded Systems']}
    >
      IoT-enabled vending machines with cashless and remote management
      capabilities. The system supports seamless self-checkout, real-time sales
      and inventory monitoring, and data access via comprehensive APIs.
    </ProjectDialog>
  </div>

  <div class="testimonials mt-24 w-shell max-w-content flex flex-wrap mx-auto max-sm:w-full max-sm:px-edge">
    <div class="flex-none w-full px-gutter max-2xs:px-0" data-animate-block="">
      <div
        class="swiper swiper-container swiper-container-horizontal testimonial-slider pb-20 relative overflow-hidden list-none z-[1] opacity-0 mx-auto no-js:opacity-100 reduced:opacity-100"
        aria-label="Testimonials"
        data-animate-el=""
      >
        <div class="swiper-wrapper relative w-full h-full z-[1] flex [transition-property:transform] box-content [transform:translate3d(0px,_0,_0)] no-js:flex-wrap">
          <Testimonial image={jojuAvatar} name="Joju" role="CEO, Jorrel">
            Awesome is not only skilled at what he does but also dependable and
            easy to work with. It's always a pleasure working with him.
          </Testimonial>

          <Testimonial
            image={emmanuelAvatar}
            name="Emmanuel Grant"
            role="Partner, Sterlasvan"
          >
            Awesome approaches problems logically and understands ideas quickly,
            often without the need for lengthy explanations.
          </Testimonial>
        </div>

        <div class="swiper-pagination absolute text-center [transition:300ms_opacity] [transform:translate3d(0,0,0)] z-[10] bottom-[10px] left-0 w-full [&.swiper-pagination-lock]:hidden [&.swiper-pagination-hidden]:opacity-0"></div>
      </div>
    </div>
  </div>
</section>
