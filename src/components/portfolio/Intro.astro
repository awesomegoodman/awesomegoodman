---
import SectionTitle from './SectionTitle.astro';
---

<section
  id="intro"
  class="s-intro target-section relative [--gutter:60px] [--intro-scale:1] max-2xl:[--intro-scale:0.92] max-xl:[--intro-scale:0.85] max-lg:[--intro-scale:0.8] max-900:[--intro-scale:0.75] max-md:[--intro-scale:0.7] max-md:[--gutter:40px] max-sm:[--intro-scale:0.58] max-sm:[--gutter:20px] max-xs:[--intro-scale:0.55] max-md:no-js:min-h-auto"
>
  <div class="intro-content pt-[calc(16vh_+_var(--spacing-header))] pb-24 w-shell max-w-wide flex flex-wrap min-h-204 justify-center items-center mx-auto max-lg:pt-[calc(14vh_+_var(--spacing-header))] max-md:pt-[160px] max-md:min-h-0 max-md:items-start max-sm:w-full max-sm:px-edge">
    <div class="flex-1 px-gutter max-2xs:flex-none max-2xs:w-full max-2xs:px-0">
      <SectionTitle as="div" line>
        Hello World
      </SectionTitle>

      <h1 class="text-huge-title text-[length:calc(108px*var(--intro-scale))] mb-6 pr-[5vw] font-display font-normal text-white [font-variant-ligatures:common-ligatures] leading-[1.074] tracking-tight max-2xs:text-display max-2xs:leading-16 max-md:mb-12 max-md:pr-0">
        I am Awesome, <br class="max-900:hidden" />a software engineer.
      </h1>
    </div>

    <ul class="intro-social pl-[96px] list-none z-[1] flex text-[length:10px] font-normal uppercase tracking-wide [transform:rotate(-90deg)_translateX(-50%)] [transform-origin:left_bottom] absolute top-1/2 left-[calc(100%_-_6rem)] max-md:pr-[80px] max-md:pl-0 max-md:transform-none max-md:relative max-md:w-full max-md:flex-wrap max-3xs:hidden max-xl:left-[calc(100%_-_4rem)] max-md:left-[var(--gutter)] max-xs:left-[14px] max-2xs:left-0">
      <li class="list-item px-[12px] max-md:px-[6px]">
        <a
          class="text-muted transition-all focus:text-white hover:text-white hover:outline-none active:outline-none"
          href="https://github.com/awesomegoodman"
        >
          Github
        </a>
      </li>
    </ul>
  </div>

  <a
    href="#about"
    class="intro-scrolldown smoothscroll group/scroll text-accent flex size-8 justify-center items-center absolute bottom-[48px] right-[58px] transition-all max-xl:right-[40px] max-sm:right-[24px] focus:text-secondary hover:text-secondary hover:outline-none active:text-secondary active:outline-none"
    aria-label="Scroll to About"
  >
    <svg
      class="size-6"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      fill-rule="evenodd"
      clip-rule="evenodd"
    >
      <path
        class="fill-white transition-all group-focus/scroll:fill-accent group-hover/scroll:fill-accent"
        d="M11 21.883l-6.235-7.527-.765.644 7.521 9 7.479-9-.764-.645-6.236 7.529v-21.884h-1v21.883z"
      />
    </svg>
  </a>
</section>
