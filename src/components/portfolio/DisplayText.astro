---
interface Props {
  as?: 'h1' | 'p' | 'ul';
  animated?: boolean;
  class?: string;
}
const { as: Tag = 'p', animated = false, class: className } = Astro.props;
---

<Tag
  class:list={[
    'h1 mb-6 font-display text-display font-normal leading-16 tracking-tight text-white [font-variant-ligatures:common-ligatures] [text-rendering:optimizeLegibility] max-xs:text-3xl max-xs:leading-13',
    animated && 'opacity-0 no-js:opacity-100 reduced:opacity-100',
    className,
  ]}
  data-animate-el={animated ? '' : undefined}
>
  <slot />
</Tag>
