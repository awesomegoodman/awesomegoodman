---
import SectionTitle from './SectionTitle.astro';
import DisplayText from './DisplayText.astro';
import ButtonLink from './ButtonLink.astro';
import Timeline from './Timeline.astro';
import TimelineEntry from './TimelineEntry.astro';
import aboutPhotoSource from '../../assets/portfolio/about-photo.jpg';
import { getImage } from 'astro:assets';
const [aboutPhoto, aboutPhotoRetina] = await Promise.all([
  getImage({
    src: aboutPhotoSource,
    width: Math.min(900, aboutPhotoSource.width),
    format: 'webp',
    quality: 90,
  }),
  getImage({
    src: aboutPhotoSource,
    width: Math.min(1800, aboutPhotoSource.width),
    format: 'webp',
    quality: 90,
  }),
]);
---

<section id="about" class="s-about target-section pt-32 pb-24">
  <div
    class="about-info pl-[10px] w-full max-w-wide flex flex-wrap [--gutter:0] items-center mx-auto max-sm:pr-edge max-sm:w-full max-xl:w-shell max-xl:max-w-bio max-xl:[--gutter:16px]"
    data-animate-block=""
  >
    <div class="flex-none w-1/2 px-gutter max-2xs:px-0 max-xl:w-full">
      <img
        src={aboutPhoto.src}
        srcset={`${aboutPhoto.src} 1x, ${aboutPhotoRetina.src} 2x`}
        alt="Awesome Goodman at his desk"
        class="about-info__pic opacity-0 object-cover align-bottom no-js:opacity-100 reduced:opacity-100"
        data-animate-el=""
        width={aboutPhoto.attributes.width}
        height={aboutPhoto.attributes.height}
        loading="lazy"
      />
    </div>

    <div class="flex-none w-1/2 lg:pl-10 px-gutter max-2xs:px-0 max-xl:w-full">
      <div class="about-info__text pt-28 pr-[10vw] pb-16 max-1300:pt-16 max-1300:pr-[80px] max-1300:pb-12 max-xl:pt-8 max-xl:pr-0 max-xl:pb-0">
        <SectionTitle line spacing="wide" animated>
          About
        </SectionTitle>
        <p
          class="text-lead mb-8 font-sans font-light leading-10 text-white opacity-0 no-js:opacity-100 reduced:opacity-100"
          data-animate-el=""
        >
          I am a software engineer, specialising in Java, JavaScript, and Python.
          I build software end-to-end, from initial ideation through to
          full-scale cloud deployment. My long-term goal is to transition into
          robotics. I am interested in STEM and anime, which I actively
          pursue in my free time.
        </p>
        <ButtonLink
          href="https://docs.google.com/document/d/1N7GhR8V_9TE0aNX9ik1xk0gMqvIQyNmBq4OaUB9lTjM/export?format=pdf"
          class="mt-8"
          target="_blank"
          rel="noopener"
        >
          Download CV
        </ButtonLink>
      </div>
    </div>
  </div>

  <div
    class="about-expertise pt-48 w-shell max-w-content flex flex-wrap mx-auto max-sm:w-full max-sm:px-edge"
    data-animate-block=""
  >
    <div class="flex-none w-full px-gutter max-2xs:px-0">
      <SectionTitle animated>Expertise</SectionTitle>

      <DisplayText as="ul" class="skills-list mt-8 list-none" animated>
        <li class="inline-block after:content-[',_']">Frontend</li>
        <li class="inline-block after:content-[',_']">Backend</li>
        <li class="inline-block after:content-[',_']">Automation</li>
        <li class="inline-block after:content-[',_']">Web3</li>
        <li class="inline-block">Mobile</li>
      </DisplayText>
    </div>
  </div>

  <div
    class="about-timelines pt-24 w-shell max-w-content flex flex-wrap mx-auto max-sm:w-full max-sm:px-edge"
    data-animate-block=""
  >
    <Timeline title="Experience">
      <TimelineEntry
        name="Retailbox"
        role="Software Engineer"
        timeframe="November 2024 - Present"
      >
        <p class="mb-8">
          A comprehensive retail management platform designed for businesses of
          all sizes. Developed and launched the platform as a solo project,
          achieving a growing number of onboarded stores since its launch on May
          15, 2025.
        </p>
      </TimelineEntry>

      <TimelineEntry
        name="Spark Strand"
        role="Software Engineer"
        timeframe="April 2025 - December 2025"
      >
        <p class="mb-8">
          Spark Strand is a United Kingdom-based creative digital and marketing
          agency that uses design, web development, and marketing expertise to
          bring ideas to life for clients across a range of industries.
        </p>
      </TimelineEntry>
    </Timeline>

    <Timeline title="Education" class="max-md:mt-12">
      <TimelineEntry
        name="Anchor University"
        role="BSc, Business Administration and Management"
        timeframe="September 2019 - July 2022"
      >
        <p class="mb-8">
          A private missionary university owned by the Deeper Christian Life
          Ministry, located in Ayobo, Lagos. The institution was founded in
          September 2017.
        </p>
      </TimelineEntry>

      <TimelineEntry
        name="Landmark University"
        role="BEng, Electrical and Electronics Engineering"
        timeframe="September 2016 - July 2019"
      >
        <p class="mb-8">
          A private Christian university located in Omu-Aran, Kwara State,
          Nigeria. Founded in 2011 by David Oyedepo and affiliated with Living
          Faith Church Worldwide.
        </p>
      </TimelineEntry>
    </Timeline>
  </div>
</section>
