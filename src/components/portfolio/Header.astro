---
import { pathTo, blogPath } from '../../lib/paths';
interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
const links = [
  { label: 'Awesome.', href: pathTo(), home: true },
  {
    label: 'Intro',
    href: standalone ? `${pathTo()}#intro` : '#intro',
    smooth: !standalone,
    current: !standalone,
  },
  {
    label: 'About',
    href: standalone ? `${pathTo()}#about` : '#about',
    smooth: !standalone,
  },
  { label: 'Works', href: '#works', smooth: true, current: standalone },
  { label: 'Say Hello', href: '#contact', smooth: true },
  {
    label: standalone ? 'Blog' : 'Portfolio',
    href: standalone ? blogPath() : pathTo('portfolio/'),
  },
  ...(!standalone ? [{ label: 'Blog', href: blogPath() }] : []),
];
---

<header class="s-header fixed top-0 left-0 z-100 w-full max-md:h-header max-md:menu-open:h-auto max-md:no-js:relative max-md:no-js:h-auto">
  <div class="header-mobile hidden h-header border-b border-b-rule bg-page shadow-header max-md:block max-md:menu-open:shadow-none">
    <span class="relative inline-block">
      <a
        class="ml-[24px] block px-[4px] text-[10px] leading-header font-normal tracking-widest text-white uppercase transition-[color,background-color] hover:text-accent focus:text-accent"
        href={pathTo()}
      >
        Awesome.
      </a>
    </span>
    <button
      class="mobile-menu-toggle absolute top-0 right-[8px] block h-header w-header cursor-pointer rounded-none border-0 border-none border-current bg-transparent text-center font-sans text-xs leading-[calc(var(--spacing)*16-2px)] font-semibold tracking-widest whitespace-nowrap text-accent uppercase antialiased transition-all ease-default hover:text-black focus:text-black max-md:no-js:hidden"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="awesome-navigation"
    >
      <span
        class:list={[
          'absolute top-1/2 right-[20px] block h-px w-[24px] -mt-px bg-white text-[0px] leading-0 font-normal text-transparent [font-family:a] [text-shadow:none] transition-[background-color] duration-200 menu-clicked:bg-transparent',
          "before:absolute before:top-[-8px] before:left-0 before:h-full before:w-full before:bg-inherit before:content-[''] before:transition-[top,transform] before:duration-[200ms,200ms] before:ease-default before:delay-[200ms,0s]",
          "after:absolute after:bottom-[-8px] after:left-0 after:h-full after:w-full after:bg-inherit after:content-[''] after:transition-[bottom,transform] after:duration-[200ms,200ms] after:ease-default after:delay-[200ms,0s]",
          'menu-clicked:before:top-0 menu-clicked:before:bg-white menu-clicked:before:[transform:rotate(45deg)] menu-clicked:before:delay-[0s,200ms]',
          'menu-clicked:after:bottom-0 menu-clicked:after:bg-white menu-clicked:after:[transform:rotate(-45deg)] menu-clicked:after:delay-[0s,200ms]',
        ]}
      >
        Menu
      </span>
    </button>
  </div>
  <div
    id="awesome-navigation"
    class:list={[
      'main-nav-wrap mx-auto flex w-shell max-w-wide flex-wrap max-lg:w-full',
      'max-md:origin-top max-md:[transform:scaleY(0)] max-md:border-b max-md:border-b-rule max-md:bg-page max-md:shadow-header',
      'max-md:menu-open:[transform:scaleY(1)] max-md:menu-open:transition-[transform] max-md:menu-open:duration-400 max-md:menu-open:ease-enter',
      'max-md:no-js:static max-md:no-js:visible max-md:no-js:h-auto max-md:no-js:opacity-100 max-md:no-js:transform-none',
    ]}
  >
    <nav
      aria-label="Portfolio navigation"
      class:list={[
        'main-nav w-full flex-none max-md:invisible max-md:pt-8 max-md:pb-12 max-md:opacity-0 max-md:[transform:translateY(-20px)]',
        'max-md:menu-open:visible max-md:menu-open:opacity-100 max-md:menu-open:[transform:translateY(0)] max-md:menu-open:transition-all max-md:menu-open:duration-400 max-md:menu-open:delay-400 max-md:menu-open:ease-enter',
        'max-md:no-js:visible max-md:no-js:opacity-100 max-md:no-js:transform-none',
      ]}
    >
      <ul class="flex list-none flex-nowrap border-x border-b border-rule bg-page max-md:block max-md:border-none max-md:border-current max-md:bg-transparent max-md:text-left">
        {links.map((link) => (
          <li
            class:list={[
              'flex-1 border-r border-r-rule last:border-none last:border-current max-md:block max-md:border-none max-md:border-current',
              'home' in link && link.home && 'max-md:hidden',
              'current' in link && link.current && 'current',
            ]}
          >
            <a
              href={link.href}
              class:list={[
                'block pr-[20px] pl-[24px] text-[10px] leading-header font-normal tracking-widest text-white uppercase transition-[color,background-color] hover:text-accent focus:text-accent',
                'max-lg:md:px-[12px] max-md:px-[28px] max-md:py-4 max-md:font-display max-md:text-lead max-md:leading-7 max-md:tracking-normal max-md:text-copy max-md:normal-case max-md:hover:text-white max-md:focus:text-white',
                'md:current:bg-panel max-md:current:text-accent!',
                'home' in link && link.home && 'home-link',
                'smooth' in link && link.smooth && 'smoothscroll',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
