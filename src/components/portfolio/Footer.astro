---
---

<footer class="s-footer mt-auto pt-8 pb-24 text-muted">
  <div class="w-shell max-w-content flex flex-wrap relative mx-auto max-sm:w-full max-sm:px-edge">
    <div class="ss-copyright -mt-2 mr-[52px] flex-1 leading-7 px-gutter max-2xs:flex-none max-2xs:w-full max-2xs:px-0">
      <span class="text-sm inline-block max-sm:block after:content-['|'] after:inline-block after:pr-[8px] after:pl-[10px] after:text-white/10 max-sm:after:hidden">
        © {new Date().getUTCFullYear()}, Awesome Goodman
      </span>
      <span class="text-sm inline-block max-sm:block">💻⚙️</span>
    </div>

    <div class="ss-go-top z-[2] absolute -top-8 right-gutter max-sm:-top-2 max-sm:right-[calc(6vw_+_var(--gutter))] max-2xs:right-edge">
      <a
        class="smoothscroll group/top bg-page text-copy flex items-center justify-center h-13 w-12 relative border border-copy transition-all focus:bg-white focus:text-white focus:border-white hover:bg-white hover:text-white hover:border-white hover:outline-none active:outline-none"
        title="Back to Top"
        aria-label="Back to top"
        href="#top"
      >
        <svg
          class="size-4 transition-all"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill-rule="evenodd"
          clip-rule="evenodd"
        >
          <path
            class="fill-white group-focus/top:fill-black group-hover/top:fill-black"
            d="M11 2.206l-6.235 7.528-.765-.645 7.521-9 7.479 9-.764.646-6.236-7.53v21.884h-1v-21.883z"
          />
        </svg>
      </a>
    </div>
  </div>
</footer>
