---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pathTo } from '../lib/content';
import { pathTo as sitePath } from '../lib/paths';
---

<BaseLayout title="Page not found" noindex canonicalPath={sitePath('404.html')}>
  <div class="wrap not-found">
    <p class="eyebrow">404 / A loose page</p>
    <h1>
      This trail ends here<span class="accent">.</span>
    </h1>
    <p>
      The page may have moved, or the address may have a typo. There’s still
      plenty to explore in the notebook.
    </p>
    <div>
      <a class="button-link" href={sitePath()}>
        Back to Awesome <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href={pathTo('writing/')}>
        Browse the writing →
      </a>
    </div>
  </div>
</BaseLayout>
