---
import { render } from 'astro:content';
import EntryLayout from '../../../layouts/EntryLayout.astro';
import { published } from '../../../lib/content';
export async function getStaticPaths() {
  return (await published('projects')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const candidates = [
  ...(await published('writing')),
  ...(await published('projects')),
];
---

<EntryLayout entry={entry} headings={headings} candidates={candidates}>
  <Content />
</EntryLayout>
