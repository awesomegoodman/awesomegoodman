---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pathTo } from '../../lib/content';
---

<BaseLayout title="Page not found in Fieldnotes" noindex>
  <div class="wrap not-found">
    <p class="eyebrow">404 / A loose page</p>
    <h1>
      This trail ends here<span class="accent">.</span>
    </h1>
    <p>
      This page is missing from the notebook. Check the address or find another
      thread to follow.
    </p>
    <div>
      <a class="button-link" href={pathTo()}>
        Back to Fieldnotes ↗
      </a>
      <a class="text-link" href={pathTo('writing/')}>
        Browse the writing →
      </a>
    </div>
  </div>
</BaseLayout>
