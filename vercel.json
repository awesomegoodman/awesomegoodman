{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/about", "destination": "/blog/about/", "permanent": true },
    {
      "source": "/writing/:path*",
      "destination": "/blog/writing/:path*",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/blog/projects/:path*",
      "permanent": true
    },
    {
      "source": "/tags/:path*",
      "destination": "/blog/tags/:path*",
      "permanent": true
    },
    { "source": "/rss.xml", "destination": "/blog/rss.xml", "permanent": true },
    {
      "source": "/favicon.svg",
      "destination": "/blog/favicon.svg",
      "permanent": true
    },
    { "source": "/og.png", "destination": "/blog/og.png", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    {
      "source": "/portfolio/index.html",
      "destination": "/portfolio/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
