{
  "name": "fieldnotes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file-if-exists=.env --test tests/build.test.mjs tests/site-config.test.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run format:check && npm run lint && npm run check && npm run build && npm test",
    "generate:og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "katex": "$katex"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "linkedom": "^0.18.15",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
